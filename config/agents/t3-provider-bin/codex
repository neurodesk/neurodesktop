#!/bin/sh
set -eu

if [ -r /opt/neurodesktop/agent_shell_setup.sh ]; then
    # Image-installed dependency is unavailable in the checkout.
    # shellcheck source=/dev/null
    . /opt/neurodesktop/agent_shell_setup.sh
fi

# T3 probes the provider from its own working directory, which may be
# read-only; seeding guidance must never stop the app server from starting.
if [ ! -e ./AGENTS.md ] && [ -r /opt/AGENTS.md ]; then
    cp /opt/AGENTS.md ./AGENTS.md 2>/dev/null || true
fi

exec /usr/bin/codex "$@"

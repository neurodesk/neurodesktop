#!/bin/sh
set -eu

if [ "${1:-}" = "--version" ]; then
    exec /usr/bin/opencode "$@"
fi

if [ -r /opt/neurodesktop/agent_shell_setup.sh ]; then
    # Image-installed dependency is unavailable in the checkout.
    # shellcheck source=/dev/null
    . /opt/neurodesktop/agent_shell_setup.sh
fi

# The interactive wrapper stores this key as a ~/.bashrc export, and T3 execs
# this launcher without a login shell, so the image's default OpenCode provider
# would otherwise reach llm.neurodesk.org unauthenticated.
if [ -z "${NEURODESK_API_KEY:-}" ] && [ -f "${HOME:-}/.bashrc" ]; then
    NEURODESK_API_KEY=$(sed -nE \
        -e "s/^[[:space:]]*export[[:space:]]+NEURODESK_API_KEY='([^']+)'[[:space:]]*\$/\1/p" \
        -e "s/^[[:space:]]*export[[:space:]]+NEURODESK_API_KEY=\"([^\"]+)\"[[:space:]]*\$/\1/p" \
        -e "s/^[[:space:]]*export[[:space:]]+NEURODESK_API_KEY=([^[:space:]#]+)[[:space:]]*\$/\1/p" \
        "${HOME}/.bashrc" 2>/dev/null | tail -n 1)
    if [ -n "${NEURODESK_API_KEY}" ]; then
        export NEURODESK_API_KEY
    else
        unset NEURODESK_API_KEY
    fi
fi

case "${1:-}" in
    serve|acp)
        exec python3 /opt/neurodesktop/opencode_update_config.py --quiet-exec /usr/bin/opencode \
            /opt/jovyan_defaults/.config/opencode/opencode.json "$@"
        ;;
    *)
        exec /usr/bin/opencode "$@"
        ;;
esac

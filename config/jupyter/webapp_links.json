{
  "webapps": {
    "dicompare": null,
    "jamovi": {
      "startup_timeout": 300,
      "path_rewrites": [
        {
          "from": "/assets/",
          "to": "${base_path}assets/"
        },
        {
          "from": "\"/version\"",
          "to": "\"${base_path}version\""
        },
        {
          "from": "\"/settings\"",
          "to": "\"${base_path}settings\""
        }
      ]
    },
    "qsmbly": null,
    "more-webapps": {
      "title": "More webapps",
      "description": "Browse more Neurodesk web applications",
      "direct_url": "https://webapps.neurodesk.org/",
      "icon": "/opt/neurodesk_brain_icon.svg"
    }
  }
}
